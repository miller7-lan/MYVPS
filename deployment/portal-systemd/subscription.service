[Unit]
Description=Dazzle private-sharing registration and subscription HTTPS endpoint
After=network-online.target dazzle-vps-agent.service
Wants=network-online.target
Requires=dazzle-vps-agent.service

[Service]
Type=exec
User=dazzle-web
Group=dazzle-web
ExecStart=/opt/dazzle-vps/current/venv/bin/python -I -m dazzle.portal --socket /run/dazzle-vps-portal/agent.sock --host 0.0.0.0 --port 9443 --cert /etc/dazzle-vps/web-tls/cert.pem --key /etc/dazzle-vps/web-tls/key.pem --origin @ORIGIN@
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=96M
TasksMax=64
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
