[Unit]
Description=Dazzle independent verified meter guard and network gate for member %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Environment=PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
Type=notify
NotifyAccess=main
User=dazzle-agent
Group=dazzle-agent
SupplementaryGroups=dazzle-vps
ExecStart=/opt/dazzle-vps/releases/@RELEASE_ID@/venv/bin/python -I -m dazzle.meter_guard --policy /etc/dazzle-vps/policy.json --state-dir /var/lib/dazzle-vps --worker-id %i
# Root, outside the sandbox below: READY opens the member's network gate and every
# exit closes it again. If the gate module itself fails, a gated Core is stopped.
ExecStartPost=+/opt/dazzle-vps/releases/@RELEASE_ID@/venv/bin/python -I -m deployment.member_gate open %i
ExecStopPost=+/bin/sh -c '/opt/dazzle-vps/releases/@RELEASE_ID@/venv/bin/python -I -m deployment.member_gate close %i || { { [ -e /etc/systemd/system/dazzle-proxy@%i.service.d/40-dazzle-member-gate.conf ] || grep -qx IPAddressDeny=any /etc/systemd/system/dazzle-proxy@.service; } && /usr/bin/systemctl stop --no-block dazzle-proxy@%i.service; }'
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=3
WatchdogSec=5
# A stale meter keeps the guard waiting before READY, with its member's gate shut. The bound
# keeps a member start queued behind a waiting guard from hanging; it proceeds gated.
TimeoutStartSec=60
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/dazzle-vps
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=64M
TasksMax=16
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20
