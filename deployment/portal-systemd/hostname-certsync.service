[Unit]
Description=Validate and copy the portal hostname certificate beside, never over, the IP pair

[Service]
Environment=PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
Type=oneshot
User=root
Group=root
ExecStart=/opt/dazzle-vps/current/venv/bin/python -I -m deployment.certsync --managed-certbot-source --hostname @HOSTNAME@ --source-cert /etc/letsencrypt/live/@HOSTNAME@/fullchain.pem --source-key /etc/letsencrypt/live/@HOSTNAME@/privkey.pem
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/dazzle-vps/web-tls
ReadOnlyPaths=/etc/letsencrypt/live/@HOSTNAME@ /etc/letsencrypt/archive/@HOSTNAME@
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=64M
TasksMax=16
